APP_ENV=development
# Set true to expose /api/v1/docs/ when APP_ENV=production
# ENABLE_API_DOCS=true
HTTP_PORT=8080
LOG_LEVEL=info

# Docker Compose maps Postgres to host port 5433 (see docker-compose.yml).
DATABASE_URL=postgres://app:app@localhost:5433/go_connect?sslmode=disable

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SEC=300


JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Storage (MinIO via docker compose) ---
# Leave STORAGE_PROVIDER empty to disable file uploads; KYC/profile can still use raw URLs.
STORAGE_PROVIDER=s3
S3_BUCKET=go-connect-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BASE_URL=http://localhost:9000/go-connect-uploads

# --- Razorpay (employee subscriptions) ---
# Without these, create-order returns gateway-not-configured; webhooks stay disabled.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# --- SMTP (password reset, email verify, booking emails) ---
# Without SMTP_HOST, emails are skipped silently; in-app notifications still work.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# --- FCM push (mobile notifications) ---
# Without these, push uses noop; in-app + WebSocket notifications still work.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# --- OTP login/registration tuning (optional; defaults shown) ---
# OTP_CODE_LENGTH=6
# OTP_CODE_TTL_MINUTES=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_PER_WINDOW=5
# OTP_WINDOW_MINUTES=15
# OTP_MAX_ATTEMPTS=5

# --- OTP SMS provider ---
# OTP_PROVIDER selects the delivery transport. Leave empty for the dev behaviour:
# in non-production the generated code is logged (never sent); in production
# the sender is a no-op. Set OTP_PROVIDER=msg91 or OTP_PROVIDER=twilio to send
# real SMS, or OTP_PROVIDER=email to use the SMTP dev fallback (reuses SMTP_*;
# note phone-only users may have no email, so SMS is the real path).
# OTP_PROVIDER=twilio

# --- MSG91 (OTP SMS for India) ---
# Required when OTP_PROVIDER=msg91. We generate/verify the code ourselves and
# use MSG91 only to deliver it via a DLT-approved template.
# AUTH_KEY: MSG91 panel → Settings → API.
# SENDER_ID: your 6-char DLT-approved header (e.g. GOCONN).
# TEMPLATE_ID: DLT-approved OTP template id from MSG91.
# OTP_VAR: the template variable the code is injected into (e.g. OTP or var1).
# Phones are sent with country code and no leading '+' (e.g. 9198XXXXXXXX).
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_SENDER_ID=GOCONN
# MSG91_TEMPLATE_ID=your-dlt-template-id
# MSG91_OTP_VAR=OTP

# --- Twilio (OTP SMS, works for dev/testing without DLT) ---
# Set OTP_PROVIDER=twilio to activate. We generate/verify the OTP; Twilio only
# delivers the SMS. Trial accounts can only send to verified numbers. Production
# SMS to Indian (+91) numbers additionally requires India DLT registration
# (regulatory, not code). Phones are sent in E.164 with a leading '+'.
# From your Twilio console: Account SID + Auth Token, and either a Twilio phone
# number (TWILIO_FROM_NUMBER) or a Messaging Service SID.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=
# OTP_SMS_TEMPLATE=Your Go Connect verification code is {code}. It expires in a few minutes.
