APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# Docker Compose maps Postgres to host port 5433 (see docker-compose.yml).
DATABASE_URL=postgres://app:app@localhost:5433/go_connect?sslmode=disable

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SEC=300


JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Storage (MinIO via docker compose) ---
# Leave STORAGE_PROVIDER empty to disable file uploads; KYC/profile can still use raw URLs.
STORAGE_PROVIDER=s3
S3_BUCKET=go-connect-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BASE_URL=http://localhost:9000/go-connect-uploads

# --- Razorpay (employee subscriptions) ---
# Without these, create-order returns gateway-not-configured; webhooks stay disabled.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# --- SMTP (password reset, email verify, booking emails) ---
# Without SMTP_HOST, emails are skipped silently; in-app notifications still work.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# --- FCM push (mobile notifications) ---
# Without these, push uses noop; in-app + WebSocket notifications still work.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
