# Copy to repo root as .env on the Azure VM:
#   cp deploy/azure/env.example .env
#
# No domain? Leave DOMAIN empty — setup-vm.sh auto-uses nip.io from the VM IP.

APP_ENV=production
HTTP_PORT=8080
LOG_LEVEL=info

# Docker Postgres (same VM) — change password below
POSTGRES_PASSWORD=change-me-strong-postgres-password
DATABASE_URL=postgres://app:change-me-strong-postgres-password@127.0.0.1:5432/go_connect?sslmode=disable

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SEC=300

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Leave empty for nip.io auto-config, or set e.g. goconnect.in
DOMAIN=

# Filled automatically when DOMAIN is empty (or set manually):
# CORS_ALLOWED_ORIGINS=http://www.20-1-2-3.nip.io,http://admin.20-1-2-3.nip.io,...
# API_URL=http://api.20-1-2-3.nip.io/api/v1

# MinIO on same VM — match MINIO_ROOT_PASSWORD and S3_SECRET_KEY
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
STORAGE_PROVIDER=s3
S3_BUCKET=go-connect-uploads
S3_REGION=centralindia
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-strong-minio-password
S3_ENDPOINT=http://127.0.0.1:9000
S3_BASE_URL=http://api.YOUR_DOMAIN/files

# Set USE_HTTPS=true after running certbot (optional, only with a real domain or nip.io)
USE_HTTPS=false
