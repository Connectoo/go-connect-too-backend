# Single VM in Azure VNet — frontends public, API + Postgres private.
# See docs/DEPLOYMENT_AZURE_VPC.md

APP_ENV=production
# Swagger UI at /api/v1/docs/ (demo only — disable after client testing)
ENABLE_API_DOCS=true
HTTP_PORT=8080
LOG_LEVEL=info
VPC_MODE=true

POSTGRES_PASSWORD=change-me-strong-postgres-password
DATABASE_URL=postgres://app:change-me-strong-postgres-password@127.0.0.1:5432/go_connect?sslmode=disable

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SEC=300

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# HTTP testing: leave empty (auto nip.io). HTTPS: set your real domain e.g. goconnect.in
DOMAIN=
USE_HTTPS=false
# Required for Let's Encrypt (enable-https-vpc.sh):
# LETSENCRYPT_EMAIL=you@yourdomain.com
# After HTTPS, auto-filled by setup/enable scripts (only needed for direct api.* browser calls):
# CORS_ALLOWED_ORIGINS=https://www.connectoo.online,https://admin.connectoo.online,https://app.connectoo.online,https://provider.connectoo.online,https://api.connectoo.online

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
# MinIO web UI (optional — run enable-minio-console-vpc.sh after HTTPS):
# MINIO_BROWSER_REDIRECT_URL=https://minio.connectoo.online  # set by enable-minio-console-vpc.sh
STORAGE_PROVIDER=s3
S3_BUCKET=go-connect-uploads
S3_REGION=centralindia
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-strong-minio-password
S3_ENDPOINT=http://127.0.0.1:9000

# Next.js bind localhost — Nginx proxies to the internet
BIND_HOST=127.0.0.1
