# Single VM in Azure VNet — frontends public, API + Postgres private.
# See docs/DEPLOYMENT_AZURE_VPC.md

APP_ENV=production
HTTP_PORT=8080
LOG_LEVEL=info
VPC_MODE=true

POSTGRES_PASSWORD=change-me-strong-postgres-password
DATABASE_URL=postgres://app:change-me-strong-postgres-password@127.0.0.1:5432/go_connect?sslmode=disable

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SEC=300

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Leave empty for nip.io from public IP; or set e.g. goconnect.in
DOMAIN=
USE_HTTPS=false
# CORS, S3_BASE_URL auto-filled by setup-vm-vpc.sh

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
STORAGE_PROVIDER=s3
S3_BUCKET=go-connect-uploads
S3_REGION=centralindia
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-strong-minio-password
S3_ENDPOINT=http://127.0.0.1:9000

# Next.js bind localhost — Nginx proxies to the internet
BIND_HOST=127.0.0.1
