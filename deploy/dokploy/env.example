# Copy these into Dokploy → Compose → Environment tab

POSTGRES_PASSWORD=change-me-strong-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

APP_ENV=production
LOG_LEVEL=info

# MinIO console (Dokploy Domain → service "minio" → port 9001)
MINIO_BROWSER_REDIRECT_URL=https://minio.connectoo.online

# Public URLs for uploaded files shown in the API (browser-accessible).
# minio.connectoo.online points at the console (9001), not S3 (9000).
# Option A: proxy files through API (if you add that route later)
# S3_BASE_URL=https://api.connectoo.online/files
# Option B: add a second Dokploy domain for S3 API, e.g. storage.connectoo.online → minio:9000
# S3_BASE_URL=https://storage.connectoo.online/go-connect-uploads

# Disable file uploads on first deploy:
# STORAGE_PROVIDER=

# Optional integrations — see repo .env.example
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_JSON=
