# Copy these into Dokploy → Compose → Environment tab

POSTGRES_PASSWORD=change-me-strong-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

APP_ENV=production
LOG_LEVEL=info

# API CORS — all frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://www.connectoo.online,https://admin.connectoo.online,https://app.connectoo.online,https://provider.connectoo.online

# Next.js build-time URLs (rebuild frontends after changing)
NEXT_PUBLIC_API_URL=https://api.connectoo.online/api/v1
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=https://app.connectoo.online
NEXT_PUBLIC_EMPLOYEE_PORTAL_URL=https://provider.connectoo.online

# MinIO console (Dokploy Domain → service "minio" → port 9001)
MINIO_BROWSER_REDIRECT_URL=https://minio.connectoo.online

# Public URLs for uploaded files (optional)
# S3_BASE_URL=https://storage.connectoo.online/go-connect-uploads

# Disable file uploads on first deploy:
# STORAGE_PROVIDER=

# Optional integrations — see repo .env.example
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_JSON=
