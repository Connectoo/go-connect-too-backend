# Dokploy only — paste into Compose → Environment tab (do not commit real secrets).
# Repo: branch azure (or main) · Compose file: docker-compose.dokploy.yml

# --- Secrets (rotate; use openssl rand -hex 32) ---
POSTGRES_PASSWORD=change-me-strong-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# --- API ---
APP_ENV=production
LOG_LEVEL=info
ENABLE_API_DOCS=true

# Browser CORS — include api.* if mobile/Swagger call API directly
CORS_ALLOWED_ORIGINS=https://www.connectoo.online,https://admin.connectoo.online,https://app.connectoo.online,https://provider.connectoo.online,https://api.connectoo.online

# --- Next.js (build-time — redeploy after changing) ---
NEXT_PUBLIC_API_URL=https://api.connectoo.online/api/v1
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=https://app.connectoo.online
NEXT_PUBLIC_EMPLOYEE_PORTAL_URL=https://provider.connectoo.online

# --- MinIO ---
MINIO_BROWSER_REDIRECT_URL=https://minio.connectoo.online

# Public file URLs in API responses (pick one):
# Option A — second Dokploy domain: storage.connectoo.online → minio → port 9000
S3_BASE_URL=https://storage.connectoo.online/go-connect-uploads
# Option B — disable uploads on first deploy: STORAGE_PROVIDER=

# --- Optional ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@connectoo.online
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_JSON=

# NOT used in Dokploy Compose Environment tab (host scripts / Azure only):
# DATABASE_URL, S3_ENDPOINT, BIND_HOST, VPC_MODE, USE_HTTPS
#
# For one-cert HTTPS on the VM (see deploy/dokploy/enable-https.sh):
#   DOMAIN=connectoo.online LETSENCRYPT_EMAIL=you@example.com sudo bash deploy/dokploy/enable-https.sh
